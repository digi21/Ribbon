<Window
    x:Class="RibbonGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ribbon="using:Digi21.WinUI.Ribbon">

    <!--
        The page background is the application's to paint, and this window is where you can see why.
        The ribbon paints itself with a layer brush, as WinUI's own surfaces do, and a layer brush is
        translucent by design: it is meant to sit on a page. Leave the root without one and an
        unpackaged WinUI window shows through black, which looks right by accident in a dark theme
        and turns every word invisible in a light one.
    -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ribbon:Ribbon x:Name="Ribbon">

            <ribbon:RibbonTab Label="Home">

                <!-- A group with a launcher, and one item that takes every shape while the two
                     beside it only ever go small. -->
                <ribbon:RibbonGroup Label="Clipboard" Priority="0" HasLauncher="True">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="Paste" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonGroup.LauncherFlyout>
                        <Flyout>
                            <StackPanel Spacing="8" Width="260">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Clipboard" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="A launcher opens whatever the group has no room for. It is off until you ask for it."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </ribbon:RibbonGroup.LauncherFlyout>

                    <ribbon:RibbonDropDownButton x:Name="Paste" Label="Paste">
                        <ribbon:RibbonDropDownButton.IconSource>
                            <SymbolIconSource Symbol="Paste" />
                        </ribbon:RibbonDropDownButton.IconSource>
                        <ribbon:RibbonDropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Keep formatting" />
                                <MenuFlyoutItem Text="Merge formatting" />
                                <MenuFlyoutItem Text="Text only" />
                            </MenuFlyout>
                        </ribbon:RibbonDropDownButton.Flyout>
                    </ribbon:RibbonDropDownButton>

                    <ribbon:RibbonButton Label="Cut" ribbon:Ribbon.AllowedSizes="Normal,Small">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="Cut" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>

                    <ribbon:RibbonButton Label="Copy" ribbon:Ribbon.AllowedSizes="Normal,Small">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="Copy" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>

                <!-- Two-state items, a rule between columns, and two controls of your own: one
                     wrapped so it has a name beside it, one dropped straight in. -->
                <ribbon:RibbonGroup Label="Font" Priority="10" HasLauncher="True">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="Font" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonGroup.LauncherFlyout>
                        <Flyout>
                            <TextBlock Text="Everything about type, if there were more of it." Width="240" TextWrapping="Wrap" />
                        </Flyout>
                    </ribbon:RibbonGroup.LauncherFlyout>

                    <ribbon:RibbonToggleButton Label="Bold" ribbon:Ribbon.AllowedSizes="Small">
                        <ribbon:RibbonToggleButton.IconSource>
                            <SymbolIconSource Symbol="Bold" />
                        </ribbon:RibbonToggleButton.IconSource>
                    </ribbon:RibbonToggleButton>
                    <ribbon:RibbonToggleButton Label="Italic" ribbon:Ribbon.AllowedSizes="Small">
                        <ribbon:RibbonToggleButton.IconSource>
                            <SymbolIconSource Symbol="Italic" />
                        </ribbon:RibbonToggleButton.IconSource>
                    </ribbon:RibbonToggleButton>
                    <ribbon:RibbonToggleButton Label="Underline" ribbon:Ribbon.AllowedSizes="Small">
                        <ribbon:RibbonToggleButton.IconSource>
                            <SymbolIconSource Symbol="Underline" />
                        </ribbon:RibbonToggleButton.IconSource>
                    </ribbon:RibbonToggleButton>

                    <ribbon:RibbonSeparator />

                    <ribbon:RibbonContentItem Label="Size">
                        <NumberBox x:Name="FontSize" Width="92" Value="12" SpinButtonPlacementMode="Compact" />
                    </ribbon:RibbonContentItem>

                    <!-- No wrapper and nothing declared. It is laid out as Normal, and the ribbon
                         does not take the focus away from it. -->
                    <ComboBox
                        x:Name="Typeface"
                        Width="132"
                        AutomationProperties.Name="Typeface"
                        SelectedIndex="0">
                        <x:String>Segoe UI</x:String>
                        <x:String>Cascadia Mono</x:String>
                        <x:String>Georgia</x:String>
                    </ComboBox>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Label="Paragraph" Priority="20">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="AlignLeft" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonButton Label="Align left">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="AlignLeft" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                    <ribbon:RibbonButton Label="Centre">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="AlignCenter" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                    <ribbon:RibbonButton Label="Align right">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="AlignRight" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>

            </ribbon:RibbonTab>

            <ribbon:RibbonTab Label="Insert">
                <ribbon:RibbonGroup Label="Illustrations" Priority="0">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="Pictures" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonButton Label="Picture">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="Pictures" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                    <ribbon:RibbonButton Label="Shapes">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="Shop" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Label="Links" Priority="10">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="Link" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonButton Label="Link">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="Link" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                    <ribbon:RibbonButton Label="Bookmark">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="Bookmarks" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

            <ribbon:RibbonTab Label="View">
                <ribbon:RibbonGroup Label="Zoom" Priority="0">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="ZoomIn" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonButton Label="Zoom in">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="ZoomIn" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                    <ribbon:RibbonButton Label="Zoom out">
                        <ribbon:RibbonButton.IconSource>
                            <SymbolIconSource Symbol="ZoomOut" />
                        </ribbon:RibbonButton.IconSource>
                    </ribbon:RibbonButton>
                </ribbon:RibbonGroup>

                <ribbon:RibbonGroup Label="Show" Priority="10">
                    <ribbon:RibbonGroup.IconSource>
                        <SymbolIconSource Symbol="View" />
                    </ribbon:RibbonGroup.IconSource>
                    <ribbon:RibbonContentItem Label="Ruler">
                        <ToggleSwitch OnContent="On" OffContent="Off" />
                    </ribbon:RibbonContentItem>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>

        </ribbon:Ribbon>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="720" Margin="24" HorizontalAlignment="Left" Spacing="18">

                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Narrow this window." />

                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    Drag its edge in and watch the items step down through the shapes they accept —
                    icon above text, icon beside text, icon alone — in the order the groups declared.
                    Keep going and a group folds into a button with its name on it, and the whole
                    group opens from there. Nothing ever leaves the strip.
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Text="Theme" />
                    <ComboBox x:Name="Theme" SelectionChanged="OnThemeChanged" SelectedIndex="0" Width="160">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                    <Button x:Name="MinimizeButton" Click="OnMinimize" />
                    <ToggleSwitch
                        x:Name="Simplified"
                        Header=""
                        OffContent="Full ribbon"
                        OnContent="Simplified"
                        Toggled="OnSimplified" />
                </StackPanel>

                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="One instance per item" />

                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    This window kept two references when it built the ribbon, in ordinary fields: the
                    Paste button, and the size box that is a control of its own. It has not looked
                    either of them up since. Narrow the window until Clipboard folds, change tab and
                    come back, put the ribbon away and open it over this text — then press the button
                    below. It still writes to the same two objects, because there have only ever been
                    two.
                </TextBlock>

                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    It writes to both on purpose. A label is not drawn on an item the layout has
                    taken down to its icon, nor on a group that has folded away — so at the widths
                    most worth trying, the number in the size box is where you can see that the write
                    arrived.
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="OnRename" Content="Rename Paste from code" />
                    <TextBlock x:Name="RenameResult" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Built at run time" />

                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    An application that generates its ribbon from its own registry of commands needs
                    the programmatic API to be as good as the XAML one. It is the same objects either
                    way: there is no second path through data templates.
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="OnAddTab" Content="Add a tab from code" />
                    <TextBlock x:Name="AddTabResult" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
