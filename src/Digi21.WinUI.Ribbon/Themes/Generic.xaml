<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Digi21.WinUI.Ribbon"
    xmlns:primitives="using:Digi21.WinUI.Ribbon.Primitives">

    <!--
        Deliberately plain, and deliberately first. What these templates have to get right before
        they are made to look like anything is the shape the layout depends on: one panel per group
        that can be moved into a flyout whole, and one content element per item that measures the
        same way in each of the three shapes. The colours and the states come after the probe says
        the mechanism holds.
    -->

    <Style TargetType="local:Ribbon">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid Background="{ThemeResource RibbonBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="PART_Strip">
                            <!-- A panel of its own rather than a stack, because the coloured band
                                 over a set of contextual tabs starts where its first tab starts and
                                 ends where its last one ends, and only the thing that placed the
                                 tabs knows where that is. -->
                            <primitives:RibbonTabStripPanel x:Name="PART_TabStrip" />

                            <!--
                                The way back, and the only one there is once the ribbon is put away:
                                the chevron in the body goes with the body. Shown only while the
                                ribbon is away, so that it means one thing and the one in the body
                                means the other, rather than a single button doing the opposite of
                                what it did a moment ago.
                            -->
                            <Button
                                x:Name="PART_Expand"
                                Width="24"
                                Height="24"
                                Margin="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="{ThemeResource RibbonItemCornerRadius}"
                                Visibility="Collapsed">
                                <FontIcon FontSize="10" Glyph="&#xE70D;" />
                            </Button>
                        </Grid>

                        <Border
                            x:Name="PART_BodyHost"
                            Grid.Row="1"
                            BorderBrush="{ThemeResource RibbonBorderBrush}"
                            BorderThickness="0,1,0,1">
                            <!--
                                The chevron lives here, in the body, and not up in the tab strip: at
                                the bottom right, level with the names of the groups, which is where
                                Office puts it and where a hand goes looking for it.

                                It follows the body into the overlay, which is what makes putting the
                                ribbon back possible from there. Minimised and with nothing open it
                                is out of sight, as it is in Office; a double-click on a tab and
                                Ctrl+F1 are the ways back from there.

                                A column of its own rather than floating over the groups, so that the
                                room it takes is room the layout was never offered - the groups are
                                measured with what is left, by the Grid, without either of them
                                having to know about the other.
                            -->
                            <Grid x:Name="PART_Body" Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="PART_Minimize"
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{ThemeResource RibbonItemCornerRadius}">
                                    <FontIcon x:Name="PART_MinimizeGlyph" FontSize="10" Glyph="&#xE70E;" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--
                            Where the ribbon goes while it is minimised and somebody has clicked a
                            tab. Light dismissal is what closes it on a click elsewhere and on Esc,
                            which is two of the three ways out; invoking a command is the third and
                            the ribbon closes it from code.

                            The same body element moves in and out of here. It is the mechanism a
                            group already uses to fold, for the same reason: what an application put
                            in a group has to be the same object afterwards.
                        -->
                        <Popup x:Name="PART_Overlay" IsLightDismissEnabled="True">
                            <!-- Its own background rather than the ribbon's, and an opaque one: the
                                 ribbon's is a layer brush, which is meant to sit on the window and
                                 has nothing behind it out here. -->
                            <Border
                                x:Name="PART_OverlayHost"
                                Background="{ThemeResource RibbonOverlayBackgroundBrush}"
                                BorderBrush="{ThemeResource RibbonBorderBrush}"
                                BorderThickness="0,1,0,1" />
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonTab">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonTab">
                    <primitives:RibbonGroupsPanel x:Name="PART_Groups" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="primitives:RibbonTabHeader">
        <!--
            The focus, drawn. These templates belong to this library rather than to WinUI, and a
            template that does not ask for the system focus visual does not get one - which is how
            a ribbon ends up with arrow keys that move a focus nobody can see. Every style here
            that a key can land on asks for it.
        -->
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="{ThemeResource RibbonTabPadding}" />
        <Setter Property="Foreground" Value="{ThemeResource RibbonTabForegroundBrush}" />

        <!-- What a contextual tab is marked in when it is not in a group. A tab in one takes the
             heading's colour instead, written over this by the ribbon. -->
        <Setter Property="Accent" Value="{ThemeResource RibbonContextualTabAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:RibbonTabHeader">
                    <Grid
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="{ThemeResource RibbonTabCornerRadius}">
                        <!--
                            The tab tinted in the colour of the heading above it, which is what makes
                            a contextual tab tell itself apart from a fixed one at a glance rather
                            than by a two pixel line somebody has to already be looking at.

                            Under the name and over the background the pointer states paint, so a
                            contextual tab keeps its colour while the pointer is on it: the two are
                            translucent and they mix, rather than one replacing the other.
                        -->
                        <Border
                            x:Name="ContextualTint"
                            Background="{TemplateBinding Accent}"
                            CornerRadius="{ThemeResource RibbonTabCornerRadius}"
                            Opacity="0" />

                        <!-- Centred, which costs nothing while a tab is exactly as wide as its own
                             name and matters when it is not: a tab of a contextual group is widened
                             until the name on the band above it fits, and a name left hanging at
                             the left edge of the room it was given looks like a mistake. -->
                        <TextBlock
                            x:Name="Text"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!--
                            The mark of the tab on show. It is scaled rather than resized because a
                            width animation is a layout animation: it would re-measure the strip
                            sixty times a second, and the strip is where the whole ribbon decides
                            what fits. A render transform costs the layout nothing.
                        -->
                        <Rectangle
                            x:Name="SelectionIndicator"
                            Height="{ThemeResource RibbonTabSelectionIndicatorHeight}"
                            Margin="8,0"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource RibbonTabSelectionIndicatorBrush}"
                            Opacity="0"
                            RadiusX="1"
                            RadiusY="1"
                            RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="IndicatorScale" ScaleX="0.65" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!--
                            The mark of a tab that comes and goes. The top edge, because the bottom
                            one is the mark of the tab on show and a contextual tab that is also the
                            one on show has to be able to say both things at once.

                            Edge to edge rather than inset like the indicator below it: two contextual
                            tabs side by side draw one unbroken line, and that line is what the
                            coloured heading over a set of them is underlined by.
                        -->
                        <Rectangle
                            x:Name="ContextualAccent"
                            Height="{ThemeResource RibbonContextualTabAccentHeight}"
                            VerticalAlignment="Top"
                            Fill="{TemplateBinding Accent}"
                            Opacity="0" />

                        <VisualStateManager.VisualStateGroups>
                            <!--
                                Two groups that never touch the same property, so they compose: the
                                pointer decides how long the line is and whether the tab darkens,
                                the selection decides whether the line is there at all. Hovering a
                                tab that is not on show stretches a line nobody can see, which is
                                free and keeps each group answerable to one question.
                            -->
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.65"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonTabPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonTabPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionIndicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SelectionIndicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <!--
                                The third group, and it touches neither property the other two do.
                                Setters and no storyboard on purpose: a tab that has only just
                                appeared does not also need its mark to fade in, which would be two
                                arrivals for one event.
                            -->
                            <VisualStateGroup x:Name="ContextualStates">
                                <VisualState x:Name="Fixed" />
                                <VisualState x:Name="Contextual">
                                    <VisualState.Setters>
                                        <Setter Target="ContextualAccent.Opacity" Value="1" />
                                        <Setter Target="ContextualTint.Opacity" Value="{ThemeResource RibbonContextualTintOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The coloured band over a set of contextual tabs, and the one thing in this file whose height
        nothing else is measured against: the strip holds as much room as this style asks for, so a
        band given a bigger font or more padding pushes the tab names down rather than being cut.
    -->
    <Style TargetType="primitives:RibbonContextualHeading">
        <Setter Property="Foreground" Value="{ThemeResource RibbonContextualHeadingForegroundBrush}" />
        <Setter Property="Accent" Value="{ThemeResource RibbonContextualTabAccentBrush}" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:RibbonContextualHeading">
                    <Grid>
                        <!-- The same colour as the tabs under it and at the same strength, so that
                             the band and the tabs read as one block rather than as two things that
                             happen to be near each other. -->
                        <Border
                            Background="{TemplateBinding Accent}"
                            CornerRadius="{ThemeResource RibbonTabCornerRadius}"
                            Opacity="{ThemeResource RibbonContextualTintOpacity}" />

                        <TextBlock
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonGroup">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonGroup">
                    <Grid Padding="6">
                        <Grid.RowDefinitions>
                            <!--
                                Star and not Auto. Every group is arranged at the height of the
                                tallest one, and with Auto each of them kept its own items row and
                                hung its name directly under it - so a group holding a combo box put
                                its name lower than the group beside it holding only buttons. Star
                                gives the items whatever height the strip settled on and pins the
                                names to the bottom, where they line up.
                            -->
                            <RowDefinition Height="*" />
                            <!-- Named, because a ribbon of one row has no name under a group and no
                                 sixteen pixels held for one either. -->
                            <RowDefinition x:Name="PART_LabelRow" Height="16" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PART_ItemsHost">
                            <primitives:RibbonItemsPanel x:Name="PART_Items" />
                        </Border>

                        <!-- The group once it has folded. Same icon, same name, and the whole group
                             behind it, so nothing has gone anywhere. -->
                        <Button
                            x:Name="PART_Collapsed"
                            Grid.RowSpan="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed">
                            <primitives:RibbonItemContent x:Name="PART_CollapsedContent" />
                        </Button>

                        <!-- The name of the group, and beside it the launcher when the group has
                             one. Not trimmed, and it never needs to be: the layout takes the width
                             of both as a floor for the whole group, so the name of a group is always
                             readable however hard the ribbon is squeezed. -->
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="PART_Label"
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource RibbonGroupLabelForegroundBrush}" />
                            <Button
                                x:Name="PART_Launcher"
                                Width="{ThemeResource RibbonLauncherSize}"
                                Height="{ThemeResource RibbonLauncherSize}"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="{ThemeResource RibbonItemCornerRadius}"
                                Visibility="Collapsed">
                                <FontIcon FontSize="10" Glyph="&#xE76C;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonButton">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonButton">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{ThemeResource RibbonItemCornerRadius}">
                        <primitives:RibbonItemContent x:Name="PART_Content" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonToggleButton">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonToggleButton">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{ThemeResource RibbonItemCornerRadius}">
                        <primitives:RibbonItemContent x:Name="PART_Content" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemCheckedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemCheckedBackgroundBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.9" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemCheckedBackgroundBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonDropDownButton">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonDropDownButton">
                    <!-- The chevron is inside the content and not beside it, because where it goes
                         depends on the shape and only the content knows the shape. -->
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{ThemeResource RibbonItemCornerRadius}">
                        <primitives:RibbonItemContent x:Name="PART_Content" ShowsChevron="True" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource RibbonItemPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonContentItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonContentItem">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            x:Name="PART_Label"
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonSeparator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonSeparator">
                    <Border Width="9">
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource RibbonSeparatorBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
