<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Digi21.WinUI.Ribbon"
    xmlns:primitives="using:Digi21.WinUI.Ribbon.Primitives">

    <!--
        Deliberately plain, and deliberately first. What these templates have to get right before
        they are made to look like anything is the shape the layout depends on: one panel per group
        that can be moved into a flyout whole, and one content element per item that measures the
        same way in each of the three shapes. The colours and the states come after the probe says
        the mechanism holds.
    -->

    <Style TargetType="local:Ribbon">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            x:Name="PART_TabStrip"
                            Orientation="Horizontal"
                            Spacing="2" />

                        <Border
                            Grid.Row="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,1">
                            <Grid x:Name="PART_Body" Padding="4" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonTab">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonTab">
                    <primitives:RibbonGroupsPanel x:Name="PART_Groups" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="primitives:RibbonTabHeader">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:RibbonTabHeader">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4,4,0,0">
                        <TextBlock
                            x:Name="Text"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                                        <Setter Target="Text.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonGroup">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonGroup">
                    <Grid Padding="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PART_ItemsHost">
                            <primitives:RibbonItemsPanel x:Name="PART_Items" />
                        </Border>

                        <!-- The group once it has folded. Same icon, same name, and the whole group
                             behind it, so nothing has gone anywhere. -->
                        <Button
                            x:Name="PART_Collapsed"
                            Grid.RowSpan="2"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed">
                            <primitives:RibbonItemContent x:Name="PART_CollapsedContent" />
                        </Button>

                        <!-- Not trimmed, and it never needs to be: the layout takes this text's
                             width as a floor for the whole group, so the name of a group is always
                             readable however hard the ribbon is squeezed. -->
                        <TextBlock
                            x:Name="PART_Label"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <primitives:RibbonItemContent x:Name="PART_Content" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonToggleButton">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <primitives:RibbonItemContent x:Name="PART_Content" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonDropDownButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonDropDownButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <primitives:RibbonItemContent x:Name="PART_Content" />
                            <FontIcon
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Glyph="&#xE70D;" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonContentItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonContentItem">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RibbonSeparator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonSeparator">
                    <Border Width="9">
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
