<!--
    Every brush and metric the ribbon is painted with, and every sentence it says on its own account.
    Recolouring the library, remeasuring it and translating it are all the same thing: redefining a
    key in the application's resources. Retemplating is only for changing the shape of a control,
    neither its colours nor its words.

    This dictionary is merged into Application.Resources (see RibbonThemeResources), and not into
    Themes/Generic.xaml, on purpose: a key defined in the same dictionary as the template that uses
    it wins over anything the application declares, which would make the keys unoverridable. Merged
    at the bottom of the collection, everything the application merges later, and every key it
    declares directly, takes precedence over these defaults.

    The three theme dictionaries are what makes an override follow the theme: a StaticResource inside
    one resolves against that theme's system brushes, so the same key gives a different colour in
    light, dark and high contrast.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="RibbonBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="RibbonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />

            <!-- Opaque on purpose: this one floats over the application's content, where a layer
                 brush has nothing behind it and reads as a hole. -->
            <StaticResource x:Key="RibbonOverlayBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />

            <StaticResource x:Key="RibbonTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="RibbonTabPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonTabPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="RibbonTabSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />

            <StaticResource x:Key="RibbonContextualTabAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="RibbonContextualHeadingForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="RibbonGroupLabelForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />

            <StaticResource x:Key="RibbonItemPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonItemPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="RibbonItemCheckedBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="RibbonBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="RibbonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />

            <!-- Opaque on purpose: this one floats over the application's content, where a layer
                 brush has nothing behind it and reads as a hole. -->
            <StaticResource x:Key="RibbonOverlayBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />

            <StaticResource x:Key="RibbonTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="RibbonTabPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonTabPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="RibbonTabSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />

            <StaticResource x:Key="RibbonContextualTabAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="RibbonContextualHeadingForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="RibbonGroupLabelForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />

            <StaticResource x:Key="RibbonItemPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonItemPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="RibbonItemCheckedBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="RibbonBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="RibbonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />

            <!-- Opaque on purpose: this one floats over the application's content, where a layer
                 brush has nothing behind it and reads as a hole. -->
            <StaticResource x:Key="RibbonOverlayBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />

            <StaticResource x:Key="RibbonTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="RibbonTabPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonTabPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="RibbonTabSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />

            <StaticResource x:Key="RibbonContextualTabAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="RibbonContextualHeadingForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="RibbonGroupLabelForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />

            <StaticResource x:Key="RibbonItemPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="RibbonItemPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="RibbonItemCheckedBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The same in every theme, so outside the theme dictionaries. -->
    <x:Double x:Key="RibbonTabSelectionIndicatorHeight">2</x:Double>
    <x:Double x:Key="RibbonContextualTabAccentHeight">2</x:Double>

    <!-- How much of the heading colour is put behind a band and behind the tabs under it. The line
         along the top of each of those tabs is the same colour at full strength, which is what makes
         a tint this light enough to read a name through and still enough to see across a window. -->
    <x:Double x:Key="RibbonContextualTintOpacity">0.22</x:Double>
    <x:Double x:Key="RibbonLauncherSize">16</x:Double>
    <CornerRadius x:Key="RibbonTabCornerRadius">4,4,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonItemCornerRadius">4</CornerRadius>
    <Thickness x:Key="RibbonTabPadding">12,6</Thickness>

    <!-- Every sentence the ribbon says on its own account. The ribbon does not translate what an
         application puts in it - the name of a tab, of a group, of an item arrives already in the
         user's language, because only the application knows what it is saying - so what is here is
         the handful of things the ribbon says by itself. Three of the eight are only ever heard; the
         other five are a tooltip as well.

         A placeholder at the start of one of these is written as it stands. WPF would read an
         opening brace there as the start of a markup extension and want the {} escape in front of
         it; WinUI reads the content of an x:String literally, and the escape it does not know is a
         parse error that takes the application down before its first window.

         Ribbon.TextResourceKeys is this list, so that an application can drive its own translations
         from it rather than copying the eight names and finding out years later that it mistyped
         one. -->
    <x:String x:Key="RibbonGroupLauncherNameFormat">{0} options</x:String>
    <x:String x:Key="RibbonCollapsedGroupNameFormat">{0}, collapsed group</x:String>
    <x:String x:Key="RibbonContextualTabNameFormat">{0}, contextual tab</x:String>
    <x:String x:Key="RibbonContextualTabInGroupNameFormat">{0}, contextual tab, {1}</x:String>
    <x:String x:Key="RibbonMinimizeRibbonName">Minimise the ribbon</x:String>
    <x:String x:Key="RibbonExpandRibbonName">Expand the ribbon</x:String>
    <x:String x:Key="RibbonSimplifyRibbonName">Simplify the ribbon</x:String>
    <x:String x:Key="RibbonFullRibbonName">Show the full ribbon</x:String>

</ResourceDictionary>
