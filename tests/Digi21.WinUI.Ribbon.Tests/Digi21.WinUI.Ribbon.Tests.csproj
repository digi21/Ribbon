<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Digi21.WinUI.Ribbon\Digi21.WinUI.Ribbon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The translation guide is a file nothing compiles, so a string added to RibbonStrings would
      arrive untranslated in nine languages with nothing to say so. Copying it beside the tests is
      what lets LocalisationTests read it and make that a red build.
    -->
    <None Include="..\..\docs\localisation.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
