<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Digi21.WinUI.Ribbon\Digi21.WinUI.Ribbon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Two files nothing compiles, both of which have to keep step with the keys the ribbon reads.

      The translation guide is where a key added to the library would otherwise arrive untranslated
      in nine languages with nothing to say so; the library's own dictionary is where the English
      default of each of them lives, beside the brushes. Copying them beside the tests is what lets
      LocalisationTests and RibbonTextTests read them, and makes either drift a red build.
    -->
    <None Include="..\..\docs\localisation.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Digi21.WinUI.Ribbon\Themes\RibbonResources.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
